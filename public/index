    // 打開 Lightweight Charts 彈窗 (白底明亮風格)
    function openChartModal(signalIndex) {
      const s = globalData.signals[signalIndex];
      document.getElementById("modal-title").innerText = `${s.name} (${s.ticker}) · ${s.grade} 級訊號`;
      document.getElementById("chart-modal").classList.remove("hidden");

      const chartElem = document.getElementById("chart-container");
      chartElem.innerHTML = "";

      chartInstance = LightweightCharts.createChart(chartElem, {
        width: chartElem.clientWidth,
        height: 384,
        layout: { background: { color: '#ffffff' }, textColor: '#475569' },
        grid: {
          vertLines: { color: '#f1f5f9' },
          horzLines: { color: '#f1f5f9' }
        },
        timeScale: { borderColor: '#e2e8f0' },
        rightPriceScale: { borderColor: '#e2e8f0' }
      });

      const candleSeries = chartInstance.addCandlestickSeries({
        upColor: '#ef4444', downColor: '#22c55e',
        borderUpColor: '#ef4444', borderDownColor: '#22c55e',
        wickUpColor: '#ef4444', wickDownColor: '#22c55e',
      });

      if (s.candles && s.candles.length > 0) {
        candleSeries.setData(s.candles);
      }

      if (s.ema && s.ema.length > 0) {
        const emaSeries = chartInstance.addLineSeries({
          color: '#3b82f6',
          lineWidth: 2,
        });
        emaSeries.setData(s.ema);
      }

      // 標註進場、停損、目標線
      candleSeries.createPriceLine({
        price: s.trigger_price,
        color: '#10b981',
        lineWidth: 2,
        lineStyle: LightweightCharts.LineStyle.Dashed,
        axisLabelVisible: true,
        title: '進場點',
      });

      candleSeries.createPriceLine({
        price: s.stop_loss,
        color: '#ef4444',
        lineWidth: 2,
        lineStyle: LightweightCharts.LineStyle.Dashed,
        axisLabelVisible: true,
        title: '停損點',
      });

      candleSeries.createPriceLine({
        price: s.target_price,
        color: '#3b82f6',
        lineWidth: 2,
        lineStyle: LightweightCharts.LineStyle.Dashed,
        axisLabelVisible: true,
        title: '目標價',
      });
    }

    function closeChartModal() {
      document.getElementById("chart-modal").classList.add("hidden");
      if (chartInstance) {
        chartInstance.remove();
        chartInstance = null;
      }
    }

    // 持股登記彈窗處理
    function openEntryModal(signalIndex) {
      selectedSignal = globalData.signals[signalIndex];
      const s = selectedSignal;
      const budget = parseFloat(sessionStorage.getItem("monthly_budget")) || 0;
      let initialShares = 1000;

      if (budget > 0) {
        const ratio = s.grade === "A" ? 0.50 : 0.33;
        const targetCap = budget * ratio;
        const calcShares = Math.floor(targetCap / s.trigger_price);
        if (calcShares > 0) initialShares = calcShares;
      }

      document.getElementById("reg-ticker-name").value = `${s.ticker} ${s.name} (${s.grade}級)`;
      document.getElementById("reg-entry-price").value = s.trigger_price;
      document.getElementById("reg-shares").value = initialShares;
      document.getElementById("reg-stop-loss").value = s.stop_loss;
      document.getElementById("reg-target-price").value = s.target_price;

      calculateRegAmount();
      document.getElementById("entry-modal").classList.remove("hidden");
