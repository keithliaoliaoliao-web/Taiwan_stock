    async function submitManualHolding() {
      let ticker = document.getElementById("manual-ticker").value.trim().toUpperCase();
      if (!ticker) {
        alert("請輸入股票代號");
        return;
      }
      if (!ticker.includes(".")) ticker = ticker + ".TW";

      const name = document.getElementById("manual-name").value.trim() || ticker;
      const entryPrice = parseFloat(document.getElementById("manual-entry-price").value);
      const shares = parseInt(document.getElementById("manual-shares").value);
      const stopLoss = parseFloat(document.getElementById("manual-stop-loss").value) || 0;
      const targetPrice = parseFloat(document.getElementById("manual-target-price").value) || 0;
      const entryDate = document.getElementById("manual-entry-date").value || new Date().toISOString().split("T")[0];

      if (!entryPrice || entryPrice <= 0 || !shares || shares <= 0) {
        alert("請輸入正確的買進價格與股數");
        return;
      }

      const rawRecord = {
        ticker: ticker,
        name: name,
        grade: "MANUAL",
        entry_date: entryDate,
        entry_price: entryPrice,
        shares: shares,
        stop_loss: stopLoss,
        target_price: targetPrice
      };

      // 1. 存入本機 localStorage (重新整理永不消失)
      const currentStored = getStoredHoldings();
      currentStored.push(rawRecord);
      saveStoredHoldings(currentStored);

      // 2. 即時評估並更新前端視圖
      let curClose = entryPrice;
      if (globalData && globalData.universe) {
        const u = globalData.universe.find(item => item.ticker === ticker);
        if (u) curClose = u.close;
      }
      const evalItem = evaluateHoldingItem(rawRecord, curClose);
      if (!globalData.holdings_status) globalData.holdings_status = [];
      globalData.holdings_status.push(evalItem);
      renderHoldings(globalData.holdings_status);
      closeManualHoldingModal();

      // 3. 若已設定 GitHub，非同步同步至 holdings.json
      const repo = localStorage.getItem("gh_repo");
      const token = localStorage.getItem("gh_token");
      if (repo && token) {
        try {
          const exportList = globalData.holdings_status.map(h => ({
            ticker: h.ticker,
            name: h.name,
            grade: h.grade || "MANUAL",
            entry_date: h.entry_date,
            entry_price: h.entry_price,
            shares: h.shares,
            stop_loss: h.stop_loss,
            target_price: h.target_price
          }));
          await updateGithubFile(repo, token, "holdings.json", JSON.stringify(exportList, null, 2), `feat: 手動新增持股 ${ticker}`);
          alert(`已成功儲存至本機並同步至雲端 GitHub holdings.json！`);
        } catch (e) {
          alert(`已儲存至本機！(同步至雲端 GitHub 時失敗: ${e.message})`);
        }
      } else {
        alert(`已成功儲存至本機！重新整理網頁將完整保留。(如需雲端同步，可於右上角設定 GitHub)`);
      }
    }

    // 透過 GitHub API 新增持股登記至 holdings.json
    async function submitRegistration() {
      const repo = localStorage.getItem("gh_repo");
      const token = localStorage.getItem("gh_token");

      if (!repo || !token) {
        alert("請先於右上角 [GitHub 設定] 輸入 Repository 與 Access Token");
        openGhModal();
        return;
      }

      const s = selectedSignal;
      const entryPrice = parseFloat(document.getElementById("reg-entry-price").value);
      const shares = parseInt(document.getElementById("reg-shares").value);
      const stopLoss = parseFloat(document.getElementById("reg-stop-loss").value);
      const targetPrice = parseFloat(document.getElementById("reg-target-price").value);

      if (!entryPrice || !shares || shares <= 0) {
        alert("請輸入正確的進場價格與買進股數");
        return;
      }

      const btn = document.getElementById("btn-confirm-reg");
      btn.disabled = true;
      btn.innerText = "寫入 GitHub 中...";

      try {
        const newRecord = {
          ticker: s.ticker,
          name: s.name,
          grade: s.grade,
          entry_date: new Date().toISOString().split('T')[0],
          entry_price: entryPrice,
          shares: shares,
          stop_loss: stopLoss,
          target_price: targetPrice
        };

        // 1. 儲存於本機 localStorage (保證重新整理不消失)
        const currentStored = getStoredHoldings();
        currentStored.push(newRecord);
        saveStoredHoldings(currentStored);

        // 2. 即時更新記憶體與畫面
        const evalItem = evaluateHoldingItem(newRecord, s.close || entryPrice);
        if (!globalData.holdings_status) globalData.holdings_status = [];
        globalData.holdings_status.push(evalItem);
        renderHoldings(globalData.holdings_status);

        // 3. 雲端同步
        const existingHoldings = globalData.holdings_status.map(h => ({
          ticker: h.ticker,
          name: h.name,
          grade: h.grade,
          entry_date: h.entry_date,
          entry_price: h.entry_price,
          shares: h.shares,
          stop_loss: h.stop_loss,
          target_price: h.target_price
        }));

        const contentStr = JSON.stringify(existingHoldings, null, 2);
        const repo = localStorage.getItem("gh_repo");
        const token = localStorage.getItem("gh_token");
        if (repo && token) {
          try {
            await updateGithubFile(repo, token, "holdings.json", contentStr, `feat: 買進建立持股 ${s.ticker} (${shares}股)`);
            alert(`已成功將 ${s.ticker} 儲存至本機並同步至 GitHub holdings.json！`);
          } catch (e) {
            alert(`已儲存至本機！(同步至 GitHub 失敗: ${e.message})`);
          }
        } else {
          alert(`已成功將 ${s.ticker} 儲存至本機！重新整理網頁將完整保留。(如需雲端同步，可於右上角設定 GitHub)`);
        }
        closeEntryModal();
      } catch (err) {
        alert("寫入失敗: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "確認並透過 GitHub 登記";
      }
    }

    // 透過 GitHub API 刪除或平倉持股
    async function removeHolding(index, actionName) {
      const repo = localStorage.getItem("gh_repo");
      const token = localStorage.getItem("gh_token");

      if (!repo || !token) {
        alert("請先完成 GitHub 授權設定");
        openGhModal();
        return;
      }

      const target = globalData.holdings_status[index];
      if (!confirm(`確定要${actionName}「${target.ticker} ${target.name}」嗎？`)) return;

      try {
        const updated = globalData.holdings_status.filter((_, i) => i !== index).map(h => ({
          ticker: h.ticker,
          name: h.name,
          grade: h.grade,
          entry_date: h.entry_date,
          entry_price: h.entry_price,
          shares: h.shares,
          stop_loss: h.stop_loss,
          target_price: h.target_price
        }));

        // 1. 從本機 localStorage 移除
        const stored = getStoredHoldings().filter(h => !(h.ticker === target.ticker && h.entry_date === target.entry_date));
        saveStoredHoldings(stored);

        // 2. 從記憶體中移除並重繪
        globalData.holdings_status.splice(index, 1);
        renderHoldings(globalData.holdings_status);

        // 3. 若有設定 GitHub 則同步
        const repo = localStorage.getItem("gh_repo");
        const token = localStorage.getItem("gh_token");
        if (repo && token) {
          try {
            const contentStr = JSON.stringify(updated, null, 2);
            await updateGithubFile(repo, token, "holdings.json", contentStr, `chore: ${actionName}持股 ${target.ticker}`);
          } catch(e) {
            console.error("同步至 GitHub 失敗", e);
          }
        }
        alert(`已成功更新持股資料庫！`);
      } catch (err) {
        alert("更新失敗: " + err.message);
      }
    }

    // GitHub API 核心寫入函式 (Base64 UTF-8)
    async function updateGithubFile(repo, token, path, content, message) {
      const getUrl = `https://api.github.com/repos/${repo}/contents/${path}`;
      const getRes = await fetch(getUrl, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/vnd.github.v3+json'
        }
      });

      let sha = "";
      if (getRes.ok) {
        const fileInfo = await getRes.json();
        sha = fileInfo.sha;
      }

      // 支援中文字元的 UTF-8 Base64 編碼
      const utf8Bytes = new TextEncoder().encode(content);
      let binaryStr = "";
      for (let i = 0; i < utf8Bytes.length; i++) {
        binaryStr += String.fromCharCode(utf8Bytes[i]);
      }
      const base64Content = window.btoa(binaryStr);

      const putRes = await fetch(getUrl, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
          'Accept': 'application/vnd.github.v3+json'
        },
        body: JSON.stringify({
          message: message,
          content: base64Content,
          sha: sha || undefined
        })
      });

      if (!putRes.ok) {
        const errJson = await putRes.json();
        throw new Error(errJson.message || "GitHub API 回傳異常");
      }
    }

    // GitHub 彈窗控制
    function openGhModal() {
      document.getElementById("gh-repo").value = localStorage.getItem("gh_repo") || "";
      document.getElementById("gh-token").value = localStorage.getItem("gh_token") || "";
      document.getElementById("gh-modal").classList.remove("hidden");
    }

    function closeGhModal() {
      document.getElementById("gh-modal").classList.add("hidden");
    }

    function saveGhSettings() {
      const repo = document.getElementById("gh-repo").value.trim();
      const token = document.getElementById("gh-token").value.trim();
      localStorage.setItem("gh_repo", repo);
      localStorage.setItem("gh_token", token);
      alert("GitHub 設定已成功儲存至本機！");
      closeGhModal();
    }
  </script>
