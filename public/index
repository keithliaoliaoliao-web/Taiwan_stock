    // 打開 Lightweight Charts 彈窗
    function openChartModal(signalIndex) {
      const s = globalData.signals[signalIndex];
      document.getElementById("modal-title").innerText = `${s.name} (${s.ticker}) · ${s.grade} 級訊號`;
      document.getElementById("chart-modal").classList.remove("hidden");

      const chartElem = document.getElementById("chart-container");
      chartElem.innerHTML = "";

      chartInstance = LightweightCharts.createChart(chartElem, {
        width: chartElem.clientWidth,
        height: 384,
        layout: { background: { color: '#020617' }, textColor: '#94a3b8' },
        grid: {
          vertLines: { color: '#1e293b' },
          horzLines: { color: '#1e293b' }
        },
        timeScale: { borderColor: '#334155' },
        rightPriceScale: { borderColor: '#334155' }
      });

      const candleSeries = chartInstance.addCandlestickSeries({
        upColor: '#ef4444', downColor: '#22c55e',
        borderUpColor: '#ef4444', borderDownColor: '#22c55e',
        wickUpColor: '#ef4444', wickDownColor: '#22c55e',
      });
      candleSeries.setData(s.candles);

      const emaSeries = chartInstance.addLineSeries({
        color: '#f59e0b',
        lineWidth: 2,
        title: 'EMA 20'
      });
      emaSeries.setData(s.ema);

      // 進場、停損與目標價輔助水平線
      candleSeries.createPriceLine({ price: s.trigger_price, color: '#10b981', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: '觸發進場' });
      candleSeries.createPriceLine({ price: s.stop_loss, color: '#ef4444', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: '停損點' });
      candleSeries.createPriceLine({ price: s.target_price, color: '#3b82f6', lineWidth: 2, lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: '獲利目標' });

      // 訊號棒標記
      if (s.candles.length > 0) {
        const lastBar = s.candles[s.candles.length - 1];
        candleSeries.setMarkers([
          { time: lastBar.time, position: 'belowBar', color: '#10b981', shape: 'arrowUp', text: `H2 買訊 (${s.grade}級)` }
        ]);
      }
    }

