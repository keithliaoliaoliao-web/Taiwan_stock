<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>台股價格行為選股系統</title>
  <!-- 外部資源 -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 500: '#2563eb', 600: '#1d4ed8' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen font-sans antialiased selection:bg-blue-600 selection:text-white">

  <!-- 頂部導覽列 -->
  <header class="border-b border-slate-200 bg-white/90 sticky top-0 z-30 shadow-sm backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="h-8 w-2 bg-blue-600 rounded-full"></div>
        <h1 class="text-xl font-bold tracking-tight text-slate-900">台股價格行為選股系統</h1>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200 font-medium">Strategy Freeze v1</span>
      </div>
      <div class="flex items-center space-x-4">
        <div id="market-status-badge" class="text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-slate-100 text-slate-500 border border-slate-200">
          <span class="h-2 w-2 rounded-full bg-slate-400"></span>
          <span>連線中...</span>
        </div>
        <div id="last-update" class="text-xs text-slate-500 hidden sm:block">更新時間: --</div>
        <button onclick="openGhModal()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 shadow-sm transition">
          GitHub 設定
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- 預算設定區塊 -->
    <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-base font-bold text-slate-900">本月可用預算管理</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            輸入本月總投資預算，系統將依純比例自動計算 A 級（50%）與 B 級（33%）之建議進場股數與損益（無固定金額上限）。
          </p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <div class="relative flex-1 sm:w-48">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-bold">NT$</span>
            <input type="number" id="budget-input" placeholder="輸入金額" class="w-full pl-11 pr-3 py-1.5 bg-slate-50 border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-blue-500 focus:bg-white transition">
          </div>
          <button onclick="applyBudget()" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition shadow-sm">
            套用
          </button>
          <button onclick="resetBudget()" class="px-4 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition border border-slate-200">
            重設
          </button>
        </div>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-3 text-xs">
        <span class="px-3 py-1 rounded-md bg-slate-50 text-slate-700 border border-slate-200 font-medium">
          當前套用預算：<span id="budget-display" class="text-blue-600 font-bold">尚未輸入</span>
        </span>
        <span class="px-3 py-1 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium">
          A 級投入配比：50%（依預算純比例無上限）
        </span>
        <span class="px-3 py-1 rounded-md bg-blue-50 text-blue-700 border border-blue-200 font-medium">
          B 級投入配比：33%（依預算純比例無上限）
        </span>
      </div>
    </section>

    <!-- 個人持股監控 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>個人持股監控</span>
          <span id="holdings-count" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full border border-slate-200 font-semibold">0</span>
        </h2>
        <button onclick="openManualHoldingModal()" class="text-xs px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-lg flex items-center gap-1.5 transition font-medium shadow-sm">
          <span>+ 手動新增持股</span>
        </button>
      </div>
      <div id="holdings-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 持股動態卡片 -->
      </div>
    </section>

    <!-- 明日進場候選名單 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>明日進場候選名單 (H2 突破訊號)</span>
          <span id="signals-count" class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-bold">0</span>
        </h2>
      </div>
      <div id="signals-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 候選標的動態卡片 -->
      </div>
    </section>

    <!-- 醞釀中名單 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>打底醞釀中名單 (Setup Forming)</span>
          <span id="forming-count" class="text-xs bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-0.5 rounded-full font-bold">0</span>
        </h2>
      </div>
      <div id="forming-container" class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
        <!-- 醞釀中表格 -->
      </div>
    </section>

    <!-- 觀察池全覽 -->
    <section>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
        <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
          <span>核心觀察池全覽</span>
          <span id="universe-count" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full border border-slate-200 font-semibold">0</span>
        </h2>
        <div class="flex items-center gap-2">
          <label for="sector-filter" class="text-xs text-slate-500 font-medium">產業篩選:</label>
          <select id="sector-filter" onchange="renderUniverse()" class="bg-white border border-slate-300 text-slate-700 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-blue-500 shadow-sm">
            <option value="ALL">全部產業</option>
          </select>
        </div>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-600 uppercase border-b border-slate-200 font-semibold">
              <tr>
                <th class="px-4 py-3">代號</th>
                <th class="px-4 py-3">名稱</th>
                <th class="px-4 py-3">產業</th>
                <th class="px-4 py-3 text-right">收盤價</th>
                <th class="px-4 py-3 text-right">20 EMA</th>
                <th class="px-4 py-3 text-center">趨勢狀態</th>
                <th class="px-4 py-3 text-center">訊號</th>
              </tr>
            </thead>
            <tbody id="universe-tbody" class="divide-y divide-slate-100 bg-white">
              <!-- 觀察池列動態渲染 -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>

  <!-- K線走勢圖彈窗 -->
  <div id="chart-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-4xl p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-slate-900">股票名稱 (代號)</h3>
          <p id="modal-subtitle" class="text-xs text-slate-500 mt-0.5">綠虛線: 進場價 | 紅虛線: 停損價 | 藍虛線: 目標價</p>
        </div>
        <button onclick="closeChartModal()" class="text-slate-400 hover:text-slate-700 text-2xl font-light">&times;</button>
      </div>
      <div id="chart-container" class="w-full h-96 bg-white border border-slate-100 rounded-xl overflow-hidden">
        <!-- Lightweight Charts 畫布 -->
      </div>
    </div>
  </div>

  <!-- 訊號登記進場彈窗 -->
  <div id="entry-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
        <h3 class="text-base font-bold text-slate-900">納入我的持股登記</h3>
        <button onclick="closeEntryModal()" class="text-slate-400 hover:text-slate-700 text-2xl font-light">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-700 mb-1 font-medium">標的代號 / 名稱</label>
          <input type="text" id="reg-ticker-name" readonly class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-lg text-slate-600 font-medium">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">買進價格 (元)</label>
            <input type="number" step="0.01" id="reg-entry-price" oninput="calculateRegAmount()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">買進股數 (股)</label>
            <input type="number" id="reg-shares" oninput="calculateRegAmount()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
        </div>
        <div>
          <label class="block text-slate-700 mb-1 font-medium">預估投入總金額 (元)</label>
          <input type="text" id="reg-total-amount" readonly class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-lg text-blue-600 font-bold">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">停損價格 (元)</label>
            <input type="number" step="0.01" id="reg-stop-loss" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-red-600 font-medium">
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">目標價格 (元)</label>
            <input type="number" step="0.01" id="reg-target-price" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-blue-600 font-medium">
          </div>
        </div>
        <div class="pt-2">
          <button id="btn-confirm-reg" onclick="submitRegistration()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold text-sm transition shadow-sm">
            確認登記寫入
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 手動新增持股彈窗 (白底風格) -->
  <div id="manual-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-900">手動新增個人持股</h3>
          <p class="text-xs text-slate-500 mt-0.5">登記買進紀錄，系統將儲存於本機並同步至 holdings.json</p>
        </div>
        <button onclick="closeManualHoldingModal()" class="text-slate-400 hover:text-slate-700 text-2xl font-light">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">股票代號 (例: 2330)</label>
            <input type="text" id="manual-ticker" placeholder="2330.TW" onchange="autoFillStockName()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">股票名稱</label>
            <input type="text" id="manual-name" placeholder="台積電" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">訊號等級</label>
            <select id="manual-grade" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
              <option value="自選/手動">自選/手動</option>
              <option value="A">A 級訊號</option>
              <option value="B">B 級訊號</option>
            </select>
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">買進日期</label>
            <input type="date" id="manual-entry-date" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">買進價格 (元)</label>
            <input type="number" step="0.01" id="manual-entry-price" oninput="calculateManualAmount()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">買進股數 (Shares)</label>
            <input type="number" id="manual-shares" oninput="calculateManualAmount()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          </div>
        </div>
        <div>
          <label class="block text-slate-700 mb-1 font-medium">預計投入金額 (元)</label>
          <input type="text" id="manual-total-amount" readonly class="w-full px-3 py-2 bg-slate-100 border border-slate-200 rounded-lg text-blue-600 font-bold">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-700 mb-1 font-medium">停損價格 (元)</label>
            <input type="number" step="0.01" id="manual-stop-loss" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-red-600 font-medium">
          </div>
          <div>
            <label class="block text-slate-700 mb-1 font-medium">停利目標 (元)</label>
            <input type="number" step="0.01" id="manual-target-price" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-blue-600 font-medium">
          </div>
        </div>
        <div class="pt-2">
          <button id="btn-confirm-manual" onclick="submitManualHolding()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold text-sm transition shadow-sm">
            確認登記寫入
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- GitHub 設定彈窗 -->
  <div id="gh-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-900">GitHub API 授權設定</h3>
          <p class="text-xs text-slate-500 mt-0.5">設定 GitHub Personal Access Token (需具備 repo 權限)</p>
        </div>
        <button onclick="closeGhModal()" class="text-slate-400 hover:text-slate-700 text-2xl font-light">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-700 mb-1 font-medium">儲存庫路徑 (Repository)</label>
          <input type="text" id="gh-repo" placeholder="keithliaoliaoliao-web/Taiwan_stock" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
          <p class="text-[11px] text-slate-400 mt-1">格式：擁有者/專案名 (例如：keithliaoliaoliao-web/Taiwan_stock)</p>
        </div>
        <div>
          <label class="block text-slate-700 mb-1 font-medium">Personal Access Token (PAT)</label>
          <input type="password" id="gh-token" placeholder="ghp_xxxxxxxxxxxx" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:bg-white focus:border-blue-500">
        </div>
        <div class="flex items-center gap-2 pt-2">
          <button onclick="saveGhSettings()" class="flex-1 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition shadow-sm">
            儲存設定
          </button>
          <button onclick="closeGhModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-medium transition border border-slate-200">
            取消
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript 核心驅動 -->
  <script>
    let globalData = null;
    let chartInstance = null;
    let selectedSignal = null;

    // 頁面初始化
    document.addEventListener("DOMContentLoaded", () => {
      const savedBudget = sessionStorage.getItem("monthly_budget");
      if (savedBudget) {
        document.getElementById("budget-input").value = savedBudget;
        updateBudgetDisplay(parseFloat(savedBudget));
      } else {
        updateBudgetDisplay(0);
      }
      fetchData();
    });

    // 取得 scan_result.json (多路徑自動備援)
    async function fetchData() {
      const candidatePaths = [
        'public/scan_result.json',
        'scan_result.json',
        './public/scan_result.json',
        './scan_result.json',
        '../public/scan_result.json'
      ];
      let loadedData = null;
      let usedPath = '';

      for (const p of candidatePaths) {
        try {
          const res = await fetch(`${p}?t=${Date.now()}`);
          if (res.ok) {
            loadedData = await res.json();
            usedPath = p;
            break;
          }
        } catch (e) {}
      }

      if (loadedData) {
        console.log(`成功載入資料來源: ${usedPath}`);
        globalData = loadedData;
        renderDashboard(loadedData);
      } else {
        console.error("無法自任何預期路徑載入 scan_result.json");
        document.getElementById("market-status-badge").innerHTML = `
          <span class="h-2 w-2 rounded-full bg-red-500"></span>
          <span>資料載入失敗</span>
        `;
      }
    }

    const HOLDINGS_STORAGE_KEY = "tw_stock_custom_holdings";

    function getStoredHoldings() {
      try {
        const raw = localStorage.getItem(HOLDINGS_STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        console.error("讀取本機持股失敗:", e);
        return [];
      }
    }

    function saveStoredHoldings(arr) {
      try {
        localStorage.setItem(HOLDINGS_STORAGE_KEY, JSON.stringify(arr));
      } catch (e) {
        console.error("寫入本機持股失敗:", e);
      }
    }

    function evaluateHoldingItem(h, currentClose) {
      const entryPrice = parseFloat(h.entry_price) || 0;
      const shares = parseInt(h.shares) || 0;
      const stopLoss = parseFloat(h.stop_loss) || 0;
      const targetPrice = parseFloat(h.target_price) || 0;
      const close = (currentClose !== undefined && currentClose !== null && currentClose > 0) ? currentClose : entryPrice;
      const unrealizedPnl = Math.round((close - entryPrice) * shares * 100) / 100;
      const unrealizedPct = entryPrice > 0 ? Math.round(((close - entryPrice) / entryPrice) * 10000) / 100 : 0;

      let status = "HOLD";
      let actionDesc = "正常持有，距停損尚有空間";
      const distToStop = close > 0 && stopLoss > 0 ? (close - stopLoss) / close : 1.0;

      if (stopLoss > 0 && close <= stopLoss) {
        status = "STOP_LOSS";
        actionDesc = `已跌破停損價 ${stopLoss}，建議立即停損出場`;
      } else if (targetPrice > 0 && close >= targetPrice) {
        status = "TAKE_PROFIT";
        actionDesc = `已達成目標價 ${targetPrice}，建議停利出場`;
      } else if (stopLoss > 0 && distToStop < 0.05) {
        status = "NEAR_STOP";
        actionDesc = `接近停損價（距停損僅 ${(distToStop * 100).toFixed(1)}%），請高度戒備`;
      }

      return {
        ticker: h.ticker,
        name: h.name || h.ticker,
        grade: h.grade || "自選/手動",
        entry_date: h.entry_date,
        entry_price: entryPrice,
        shares: shares,
        stop_loss: stopLoss,
        target_price: targetPrice,
        current_close: close,
        unrealized_pnl: unrealizedPnl,
        unrealized_pct: unrealizedPct,
        status: status,
        action_desc: actionDesc
      };
    }

    function mergeHoldingsList(serverHoldings, localHoldings, universeList) {
      const map = new Map();
      const uMap = new Map();
      if (Array.isArray(universeList)) {
        universeList.forEach(u => {
          if (u && u.ticker) uMap.set(u.ticker, u);
        });
      }

      // 1. 先置入伺服器端持倉
      if (Array.isArray(serverHoldings)) {
        serverHoldings.forEach(s => {
          const key = `${s.ticker}_${s.entry_date}`;
          map.set(key, s);
        });
      }

      // 2. 合併本機 localStorage 之持倉
      if (Array.isArray(localHoldings)) {
        localHoldings.forEach(l => {
          const key = `${l.ticker}_${l.entry_date}`;
          if (!map.has(key)) {
            const u = uMap.get(l.ticker);
            const close = u ? u.close : l.entry_price;
            map.set(key, evaluateHoldingItem(l, close));
          }
        });
      }

      return Array.from(map.values());
    }

    // 渲染儀表板 (白底風格)
    function renderDashboard(data) {
      // 1. 頁首大盤與時間
      document.getElementById("last-update").innerText = `更新時間: ${data.scan_date} ${data.scan_time}`;
      const badge = document.getElementById("market-status-badge");
      if (data.market_status.bullish) {
        badge.className = "text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200";
        badge.innerHTML = `<span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span><span>多頭市場 (指數站上 EMA)</span>`;
      } else {
        badge.className = "text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-amber-50 text-amber-700 border border-amber-200";
        badge.innerHTML = `<span class="h-2 w-2 rounded-full bg-amber-500"></span><span>防禦警戒 (指數低於 EMA)</span>`;
      }

      // 2. 渲染持股監控
      const mergedHoldings = mergeHoldingsList(data.holdings_status, getStoredHoldings(), data.universe);
      globalData.holdings_status = mergedHoldings;
      renderHoldings(mergedHoldings);

      // 3. 渲染明日訊號
      renderSignals(data.signals);

      // 4. 渲染醞釀中名單
      renderForming(data.forming);

      // 5. 渲染觀察池
      setupSectorFilter(data.universe);
      renderUniverse();
