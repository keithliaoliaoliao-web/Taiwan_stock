    function autoFillStockName() {
      let t = document.getElementById("manual-ticker").value.trim().toUpperCase();
      if (!t) return;
      if (!t.includes(".")) t = t + ".TW";
      document.getElementById("manual-ticker").value = t;

      if (globalData && globalData.universe) {
        const found = globalData.universe.find(u => u.ticker === t);
        if (found) {
          if (!document.getElementById("manual-name").value) {
            document.getElementById("manual-name").value = found.name;
          }
          if (!document.getElementById("manual-entry-price").value) {
            document.getElementById("manual-entry-price").value = found.close;
            calculateManualAmount();
          }
        }
      }
