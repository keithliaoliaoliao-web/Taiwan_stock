      document.getElementById("entry-modal").classList.add("hidden");
      selectedSignal = null;
    }

    function calculateRegAmount() {
      const price = parseFloat(document.getElementById("reg-entry-price").value) || 0;
      const shares = parseInt(document.getElementById("reg-shares").value) || 0;
      document.getElementById("reg-total-amount").value = `NT$ ${(price * shares).toLocaleString()}`;
