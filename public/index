<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>台股價格行為選股系統</title>
  <!-- 外部資源 -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 500: '#10b981', 600: '#059669' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased selection:bg-emerald-500 selection:text-white">

  <!-- 頂部導覽列 -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="h-8 w-2 bg-emerald-500 rounded-full"></div>
        <h1 class="text-xl font-bold tracking-tight text-white">台股價格行為選股系統</h1>
        <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Strategy Freeze v1</span>
      </div>
      <div class="flex items-center space-x-4">
        <div id="market-status-badge" class="text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-slate-800 text-slate-400 border border-slate-700">
          <span class="h-2 w-2 rounded-full bg-slate-500"></span>
          <span>連線中...</span>
        </div>
        <div id="last-update" class="text-xs text-slate-400 hidden sm:block">更新時間: --</div>
        <button onclick="openGhModal()" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          GitHub 設定
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-x-0 space-y-8">

    <!-- 預算設定區塊 -->
    <section class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-base font-semibold text-white">本月可用預算管理</h2>
          <p class="text-xs text-slate-400 mt-0.5">預算僅保存在本機瀏覽器工作階段 (sessionStorage)，關閉頁面後自動清除</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <div class="relative flex-1 sm:w-48">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">NT$</span>
            <input type="number" id="budget-input" placeholder="輸入金額" class="w-full pl-11 pr-3 py-1.5 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-500">
          </div>
          <button onclick="applyBudget()" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-medium transition">
            套用
          </button>
        </div>
      </div>
    </section>

    <!-- 個人持股監控 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>個人持股監控</span>
          <span id="holdings-count" class="text-xs bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full">0</span>
        </h2>
        <button onclick="openManualHoldingModal()" class="text-xs px-3 py-1.5 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 rounded-lg flex items-center gap-1.5 transition font-medium shadow-sm">
          <span>+ 手動新增持股</span>
        </button>
      </div>
      <div id="holdings-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 持股動態卡片 -->
      </div>
    </section>

    <!-- 明日進場候選清單 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>明日進場候選名單 (H2 突破訊號)</span>
          <span id="signals-count" class="text-xs bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full">0</span>
        </h2>
      </div>
      <div id="signals-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- 候選標的動態卡片 -->
      </div>
    </section>

    <!-- 醞釀中名單 -->
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>打底醞釀中名單 (Setup Forming)</span>
          <span id="forming-count" class="text-xs bg-amber-950 text-amber-400 border border-amber-800 px-2 py-0.5 rounded-full">0</span>
        </h2>
      </div>
      <div id="forming-container" class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
        <!-- 醞釀中表格 -->
      </div>
    </section>

    <!-- 觀察池全覽 -->
    <section>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>核心觀察池全覽</span>
          <span id="universe-count" class="text-xs bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full">0</span>
        </h2>
        <div class="flex items-center gap-2">
          <label for="sector-filter" class="text-xs text-slate-400">產業篩選:</label>
          <select id="sector-filter" onchange="renderUniverse()" class="bg-slate-900 border border-slate-700 text-slate-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-emerald-500">
            <option value="ALL">全部產業</option>
          </select>
        </div>
      </div>
      <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 uppercase border-b border-slate-800">
              <tr>
                <th class="px-4 py-3">代號</th>
                <th class="px-4 py-3">名稱</th>
                <th class="px-4 py-3">產業</th>
                <th class="px-4 py-3 text-right">收盤價</th>
                <th class="px-4 py-3 text-right">20 EMA</th>
                <th class="px-4 py-3 text-center">趨勢狀態</th>
                <th class="px-4 py-3 text-center">訊號</th>
              </tr>
            </thead>
            <tbody id="universe-tbody" class="divide-y divide-slate-800">
              <!-- 觀察池列動態渲染 -->
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- K 線圖彈窗 -->
  <div id="chart-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl p-6 shadow-2xl flex flex-col max-h-[90vh]">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-white">股票名稱 (代號)</h3>
          <p id="modal-subtitle" class="text-xs text-slate-400 mt-0.5">綠虛線: 進場價 | 紅虛線: 停損價 | 藍虛線: 目標價</p>
        </div>
        <button onclick="closeChartModal()" class="text-slate-400 hover:text-white text-xl px-2 py-1">&times;</button>
      </div>
      <div id="chart-container" class="w-full h-96 bg-slate-950 rounded-xl overflow-hidden"></div>
    </div>
  </div>

  <!-- 持股登記彈窗 -->
  <div id="entry-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <h3 class="text-base font-bold text-white">納入我的持股登記</h3>
        <button onclick="closeEntryModal()" class="text-slate-400 hover:text-white text-xl">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">標的代號 / 名稱</label>
          <input type="text" id="reg-ticker-name" readonly class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-slate-300">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">買進價格 (元)</label>
            <input type="number" step="0.01" id="reg-entry-price" oninput="calculateRegAmount()" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">買進股數 (股)</label>
            <input type="number" id="reg-shares" oninput="calculateRegAmount()" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">預估投入總金額 (元)</label>
          <input type="text" id="reg-total-amount" readonly class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-emerald-400 font-bold">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">停損價格 (元)</label>
            <input type="number" step="0.01" id="reg-stop-loss" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-red-400">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">目標價格 (元)</label>
            <input type="number" step="0.01" id="reg-target-price" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-blue-400">
          </div>
        </div>
        <div class="pt-2">
          <button id="btn-confirm-reg" onclick="submitRegistration()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-semibold text-sm transition">
            確認並透過 GitHub 登記
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 手動新增持股彈窗 -->
  <div id="manual-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <h3 class="text-base font-bold text-white">手動新增個人持股</h3>
        <button onclick="closeManualHoldingModal()" class="text-slate-400 hover:text-white text-xl">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">股票代號 (例: 2330)</label>
            <input type="text" id="manual-ticker" placeholder="2330.TW" onchange="autoFillStockName()" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">股票名稱</label>
            <input type="text" id="manual-name" placeholder="台積電" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">買進價格 (元)</label>
            <input type="number" step="0.01" id="manual-entry-price" oninput="calculateManualAmount()" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">買進股數 (股)</label>
            <input type="number" id="manual-shares" oninput="calculateManualAmount()" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">預估投入金額 (元)</label>
          <input type="text" id="manual-total-amount" readonly class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-emerald-400 font-bold">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 mb-1">停損價格 (元)</label>
            <input type="number" step="0.01" id="manual-stop-loss" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-red-400">
          </div>
          <div>
            <label class="block text-slate-400 mb-1">目標價格 (元)</label>
            <input type="number" step="0.01" id="manual-target-price" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-blue-400">
          </div>
        </div>
        <div>
          <label class="block text-slate-400 mb-1">買進日期</label>
          <input type="date" id="manual-entry-date" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
        </div>
        <div class="pt-2">
          <button id="btn-confirm-manual" onclick="submitManualHolding()" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-semibold text-sm transition">
            確認儲存持股
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- GitHub 設定彈窗 -->
  <div id="gh-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <h3 class="text-base font-bold text-white">GitHub 授權設定</h3>
        <button onclick="closeGhModal()" class="text-slate-400 hover:text-white text-xl">&times;</button>
      </div>
      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">Repository (格式: 擁有者/專案名)</label>
          <input type="text" id="gh-repo" placeholder="username/my-stock-repo" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Personal Access Token (需具備 repo 寫入權限)</label>
          <input type="password" id="gh-token" placeholder="ghp_xxxxxxxxxxxx" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white">
        </div>
        <button onclick="saveGhSettings()" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-medium transition">
          儲存設定
        </button>
      </div>
    </div>
  </div>

  <!-- JavaScript 核心驅動 -->
  <script>
    let globalData = null;
    let chartInstance = null;
    let selectedSignal = null;

    const GRADE_A_CAP = 15000.0;
    const GRADE_B_CAP = 10000.0;

    // 頁面初始化
    document.addEventListener("DOMContentLoaded", () => {
      const savedBudget = sessionStorage.getItem("monthly_budget");
      if (savedBudget) {
        document.getElementById("budget-input").value = savedBudget;
      }
      fetchData();
    });

    // 取得 scan_result.json
    function fetchData() {
      fetch('scan_result.json')
        .then(res => {
          if (!res.ok) throw new Error("無法讀取 scan_result.json");
          return res.json();
        })
        .then(data => {
          globalData = data;
          renderDashboard(data);
        })
        .catch(err => {
          console.error(err);
          document.getElementById("market-status-badge").innerHTML = `
            <span class="h-2 w-2 rounded-full bg-red-500"></span>
            <span>資料載入失敗</span>
          `;
        });
    }


    const HOLDINGS_STORAGE_KEY = "tw_stock_custom_holdings";

    function getStoredHoldings() {
      try {
        const raw = localStorage.getItem(HOLDINGS_STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        console.error("讀取本機持股失敗:", e);
        return [];
      }
    }

    function saveStoredHoldings(arr) {
      try {
        localStorage.setItem(HOLDINGS_STORAGE_KEY, JSON.stringify(arr));
      } catch (e) {
        console.error("寫入本機持股失敗:", e);
      }
    }

    function evaluateHoldingItem(h, currentClose) {
      const entryPrice = parseFloat(h.entry_price) || 0;
      const shares = parseInt(h.shares) || 0;
      const stopLoss = parseFloat(h.stop_loss) || 0;
      const targetPrice = parseFloat(h.target_price) || 0;
      const close = (currentClose !== undefined && currentClose !== null && currentClose > 0) ? currentClose : entryPrice;
      const unrealizedPnl = Math.round((close - entryPrice) * shares * 100) / 100;
      const unrealizedPct = entryPrice > 0 ? Math.round(((close - entryPrice) / entryPrice) * 10000) / 100 : 0;

      let status = "HOLD";
      let actionDesc = "正常持有，距停損尚有空間";
      const distToStop = close > 0 && stopLoss > 0 ? (close - stopLoss) / close : 1.0;

      if (stopLoss > 0 && close <= stopLoss) {
        status = "STOP_LOSS";
        actionDesc = `已跌破停損價 ${stopLoss}，建議立即停損出場`;
      } else if (targetPrice > 0 && close >= targetPrice) {
        status = "TAKE_PROFIT";
        actionDesc = `已達成目標價 ${targetPrice}，建議停利出場`;
      } else if (stopLoss > 0 && distToStop < 0.05) {
        status = "NEAR_STOP";
        actionDesc = `接近停損價（距停損僅 ${(distToStop * 100).toFixed(1)}%），請高度戒備`;
      }

      return {
        ticker: h.ticker,
        name: h.name || h.ticker,
        grade: h.grade || "MANUAL",
        entry_date: h.entry_date,
        entry_price: entryPrice,
        shares: shares,
        stop_loss: stopLoss,
        target_price: targetPrice,
        current_close: close,
        unrealized_pnl: unrealizedPnl,
        unrealized_pct: unrealizedPct,
        status: status,
        action_desc: actionDesc
      };
    }

    function mergeHoldingsList(serverHoldings, localHoldings, universeList) {
      const map = new Map();
      const uMap = new Map();
      if (Array.isArray(universeList)) {
        universeList.forEach(u => {
          if (u && u.ticker) uMap.set(u.ticker, u);
        });
      }

      // 1. 先置入伺服器端經 scanner.py 計算過之持倉
      if (Array.isArray(serverHoldings)) {
        serverHoldings.forEach(s => {
          const key = `${s.ticker}_${s.entry_date}`;
          map.set(key, s);
        });
      }

      // 2. 合併本機 localStorage 之持倉（若伺服器已有則保留伺服器計算，否則依 Universe 現價動態重算）
      if (Array.isArray(localHoldings)) {
        localHoldings.forEach(l => {
          const key = `${l.ticker}_${l.entry_date}`;
          if (!map.has(key)) {
            const u = uMap.get(l.ticker);
            const close = u ? u.close : l.entry_price;
            map.set(key, evaluateHoldingItem(l, close));
          }
        });
      }

      return Array.from(map.values());
    }

    // 渲染儀表板
    function renderDashboard(data) {
      // 1. 頁首大盤與時間
      document.getElementById("last-update").innerText = `更新時間: ${data.scan_date} ${data.scan_time}`;
      const badge = document.getElementById("market-status-badge");
      if (data.market_status.bullish) {
        badge.className = "text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-emerald-950 text-emerald-400 border border-emerald-800";
        badge.innerHTML = `<span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span><span>多頭市場 (指數站上 EMA)</span>`;
      } else {
        badge.className = "text-xs px-3 py-1 rounded-full font-medium flex items-center space-x-1.5 bg-amber-950 text-amber-400 border border-amber-800";
        badge.innerHTML = `<span class="h-2 w-2 rounded-full bg-amber-400"></span><span>防禦警戒 (指數低於 EMA)</span>`;
      }

      // 2. 渲染持股監控（合併伺服器 scan_result.json 與瀏覽器 localStorage 持股）
      const mergedHoldings = mergeHoldingsList(data.holdings_status, getStoredHoldings(), data.universe);
      globalData.holdings_status = mergedHoldings;
      renderHoldings(mergedHoldings);

      // 3. 渲染明日訊號
      renderSignals(data.signals);

      // 4. 渲染醞釀中名單
      renderForming(data.forming);

      // 5. 渲染觀察池
      setupSectorFilter(data.universe);
      renderUniverse();
    }

    // 預算套用
    function applyBudget() {
      const val = parseFloat(document.getElementById("budget-input").value);
      if (val && val > 0) {
        sessionStorage.setItem("monthly_budget", val);
      } else {
        sessionStorage.removeItem("monthly_budget");
      }
      if (globalData) {
        renderSignals(globalData.signals);
      }
    }

    // 渲染個人持股卡片
    function renderHoldings(holdings) {
      const container = document.getElementById("holdings-container");
      document.getElementById("holdings-count").innerText = holdings ? holdings.length : 0;

      if (!holdings || holdings.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-8 text-center text-slate-500 bg-slate-900 border border-slate-800/80 rounded-xl text-sm">
            尚未登記任何持股，請於買進後透過登記功能新增
          </div>
        `;
        return;
      }

